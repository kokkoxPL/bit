{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["esnext"],
		"moduleResolution": "NodeNext",
		"noImplicitAny": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src/**/*"]
}
